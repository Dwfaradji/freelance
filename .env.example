# ==============================================================================
# DEVEVOKE — MODÈLE DE CONFIGURATION DES VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================
# Instructions :
# 1. Copiez ce fichier vers .env.local pour le développement local :
#    cp .env.example .env.local
# 2. Remplissez les clés réelles pour la production (Vercel, VPS ou hébergement Cloud).
# 3. Ne committez JAMAIS vos fichiers .env ou .env.local contenant de vraies clés secrètes.
# 4. Les variables sans NEXT_PUBLIC_ sont STRICTEMENT réservées au serveur Node.js.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONNEMENT & URLS DE L'APPLICATION
# ------------------------------------------------------------------------------
# Mode d'exécution de Next.js (development, production, test)
NODE_ENV=development

# URL canonique publique du site DevEvoke
# - En production : https://www.devevoke.com
# - En développement local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.devevoke.com

# ------------------------------------------------------------------------------
# 2. SERVICE RESEND (Recommandé pour la haute délivrabilité : SPF / DKIM / DMARC)
# ------------------------------------------------------------------------------
# Clé API secrète Resend (obtenue sur https://resend.com/api-keys)
# - En local : laissez 're_placeholder' ou vide pour activer le mode simulation (mock)
# - En production : renseignez votre vraie clé API secrète commençant par 're_'
RESEND_API_KEY=re_placeholder

# Expéditeur officiel pour les emails transactionnels DevEvoke
# - En production : utilisez une adresse sur votre domaine vérifié (ex: noreply@devevoke.com)
# - En dev Resend (sans domaine propre vérifié) : onboarding@resend.dev
EMAIL_FROM_NAME=DevEvoke
EMAIL_FROM_ADDRESS=noreply@devevoke.com

# Identifiant d'audience Resend (optionnel, pour l'inscription à la newsletter)
# Obtenu dans le dashboard Resend > Audiences
RESEND_AUDIENCE_ID=

# ------------------------------------------------------------------------------
# 2B. HUNTER EMAIL VERIFIER (Vérification serveur des e-mails professionnels B2B)
# ------------------------------------------------------------------------------
# Clé API secrète Hunter (obtenue sur https://hunter.io/api-keys)
# IMPORTANT : Ne JAMAIS exposer cette clé avec le préfixe NEXT_PUBLIC_.
HUNTER_API_KEY=
HUNTER_EMAIL_VERIFICATION_ENABLED=true
HUNTER_EMAIL_VERIFICATION_TIMEOUT_MS=10000
HUNTER_MIN_SCORE=80
HUNTER_ALLOW_ACCEPT_ALL=false

# ------------------------------------------------------------------------------
# 3. DESTINATAIRES INTERNES DEVEVOKE
# ------------------------------------------------------------------------------
# Adresse recevant les notifications de contacts, devis, démos et diagnostics
DEVOKE_CONTACT_EMAIL=contact@devevoke.com

# Alias de compatibilité (redirige par défaut vers DEVOKE_CONTACT_EMAIL)
EMAIL_TO=contact@devevoke.com

# ------------------------------------------------------------------------------
# 4. TRANSPORT SMTP DE SECOURS (Fallback automatique si Resend est inactif/échoue)
# ------------------------------------------------------------------------------
# Activé automatiquement par Nodemailer en cas d'absence ou défaillance de Resend.
# Exemples de serveurs SMTP courants :
# - Hostinger : smtp.hostinger.com (Port 465 SSL)
# - OVH : ssl0.ovh.net (Port 465 SSL ou 587 TLS)
# - Ionos : smtp.ionos.fr (Port 465 SSL)
# - Gmail : smtp.gmail.com (Port 465 SSL avec Mot de passe d'application)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@devevoke.com
SMTP_PASS=votre_mot_de_passe_smtp_securise

# Adresse d'expéditeur utilisée par le fallback SMTP (si différente de EMAIL_FROM_ADDRESS)
EMAIL_FROM=contact@devevoke.com

# ------------------------------------------------------------------------------
# 5. SÉCURITÉ, RATE LIMITING & ANTI-SPAM
# ------------------------------------------------------------------------------
# Désactivation du rate limiting côté serveur (utilisé pour les suites de tests)
# - false : actif (recommandé en production et dev standard, protège contre le spam / flooding)
# - true : désactivé (recommandé uniquement pendant les tests automatisés ou benchmarks)
RATE_LIMIT_DISABLED=false

# Cloudflare Turnstile (optionnel si protection anti-bot activée)
# Clé secrète côté serveur pour valider les tokens
TURNSTILE_SECRET_KEY=
# Clé publique côté client pour injecter le widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------------------------
# 6. ANALYTICS & MESURE D'AUDIENCE (RGPD / Non-PII anonymisé)
# ------------------------------------------------------------------------------
# Identifiant de flux Google Analytics 4 (GA4)
# Configuré avec anonymisation IP stricte et respect du bandeau de consentement
GA_TRACKING_ID=G-XXXXXXXXXX
